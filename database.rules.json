{
  "rules": {
    ".read": false,
    ".write": false,
    "secrets": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true && !newData.exists()",
        "pin": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true || (!data.exists() && !root.child('rooms/'+$code+'/hostUids').exists() && newData.parent().parent().parent().child('rooms').child($code).child('hostUids').child(auth.uid).val() === true))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        }
      }
    },
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true && !newData.exists()",
        "hostUids": {
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true)",
            ".write": "auth != null && ((root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true && !newData.exists()) || ($uid === auth.uid && newData.val() === true && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && ((root.child('rooms/'+$code+'/hostClaims/'+auth.uid).exists() && root.child('rooms/'+$code+'/hostClaims/'+auth.uid).val() === root.child('secrets/'+$code+'/pin').val()) || (!root.child('rooms/'+$code+'/hostUids').exists() && newData.parent().parent().parent().parent().child('secrets').child($code).child('pin').exists()))))",
            ".validate": "newData.val() === true"
          }
        },
        "hostClaims": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && newData.parent().parent().child('claimTries').child(auth.uid).val() === (root.child('rooms/'+$code+'/claimTries/'+auth.uid).exists() ? root.child('rooms/'+$code+'/claimTries/'+auth.uid).val() : 0) + 1",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
          }
        },
        "claimTries": {
          "$uid": {
            ".read": "auth != null && $uid === auth.uid",
            ".write": "auth != null && $uid === auth.uid && newData.isNumber() && newData.val() <= 8 && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true || (!root.child('rooms/'+$code+'/hostUids').exists() && newData.parent().child('hostUids').child(auth.uid).val() === true))",
          "phase": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|answering|locked|reviewing|showcase|voting|scoring|reveal|leaderboard)$/)"
          },
          "settings": {
            "mode": {
              ".validate": "newData.isString() && (newData.val() === 'all' || newData.val() === 'team')"
            },
            "lockJoin": {
              ".validate": "newData.isBoolean()"
            },
            "defaultSecs": {
              ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 3600"
            },
            "addMs": {
              ".validate": "newData.isNumber() && newData.val() >= 5000 && newData.val() <= 300000"
            },
            "minChars": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
            },
            "maxChars": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 2000"
            },
            "allowEdit": {
              ".validate": "newData.isBoolean()"
            },
            "autoSubmit": {
              ".validate": "newData.isBoolean()"
            },
            "graceMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "aiN": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
            },
            "aiHideNames": {
              ".validate": "newData.isBoolean()"
            },
            "aiCriteria": {
              ".validate": "newData.isBoolean()"
            },
            "phoneVoting": {
              ".validate": "newData.isBoolean()"
            },
            "liveTally": {
              ".validate": "newData.isBoolean()"
            },
            "maxScore": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
            },
            "scoreStep": {
              ".validate": "newData.isNumber() && (newData.val() === 0.5 || newData.val() === 1)"
            },
            "formula": {
              ".validate": "newData.isString() && (newData.val() === 'host' || newData.val() === 'mix' || newData.val() === 'votes')"
            },
            "voteWeight": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "awardTop": {
              ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 3)"
            },
            "teamAward": {
              ".validate": "newData.isString() && (newData.val() === 'sum' || newData.val() === 'place')"
            },
            "tvTheme": {
              ".validate": "newData.isString() && (newData.val() === 'light' || newData.val() === 'dark')"
            },
            "tvSize": {
              ".validate": "newData.isString() && (newData.val() === 'S' || newData.val() === 'M' || newData.val() === 'L' || newData.val() === 'XL')"
            },
            "tvSound": {
              ".validate": "newData.isBoolean()"
            },
            "tvQr": {
              ".validate": "newData.isBoolean()"
            },
            "teams": {
              "$team": {
                ".validate": "$team.matches(/^t[1-6]$/)",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "badWords": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
              }
            }
          },
          "question": {
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
            }
          },
          "showcase": {
            "roundId": {
              ".validate": "newData.isString()"
            },
            "items": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['text'])",
                "text": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
                },
                "hl": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "focus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
            },
            "$other": {
              ".validate": false
            }
          },
          "vote": {
            "open": {
              ".validate": "newData.isBoolean()"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
            },
            "live": {
              ".validate": "newData.isBoolean()"
            },
            "skipped": {
              ".validate": "newData.isBoolean()"
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "tally": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "reveal": {
            "roundId": {
              ".validate": "newData.isString()"
            },
            "top": {
              ".validate": "newData.val() === 1 || newData.val() === 3"
            },
            "items": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['n', 'team', 'rank'])",
                "n": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
                },
                "uid": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
                },
                "team": {
                  ".validate": "newData.isString() && newData.val().matches(/^t[1-6]$/)"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
                },
                "hostScore": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                },
                "votes": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "value": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "rank": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
                },
                "honoured": {
                  ".validate": "newData.isBoolean()"
                },
                "points": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "board": {
            "t": {
              "$team": {
                ".validate": "$team.matches(/^t[1-6]$/) && newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
              }
            },
            "p": {
              "$uid": {
                ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "private": {
          ".read": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
          ".write": "auth != null && (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true || (!root.child('rooms/'+$code+'/hostUids').exists() && newData.parent().child('hostUids').child(auth.uid).val() === true))",
          "bank": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['id', 'title', 'text', 'time'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
              },
              "time": {
                ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 3600"
              }
            }
          },
          "review": {
            "$round": {
              "$uid": {
                "st": {
                  ".validate": "newData.val() === 'chosen' || newData.val() === 'rejected'"
                },
                "hl": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
                },
                "reason": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 600"
                },
                "edit": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
                },
                "ai": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                },
                "score": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "order": {
            "$round": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString()"
              }
            }
          },
          "aid": {
            "$round": {
              "$uid": {
                ".validate": "newData.isString() && newData.val().matches(/^P[0-9]{2,3}$/)"
              }
            }
          },
          "ai": {
            "$round": {
              "raw": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60000"
              },
              "$other": {
                ".validate": true
              }
            }
          },
          "optionOf": {
            "$round": {
              "$uid": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
              }
            }
          },
          "hand": {
            "$round": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              }
            }
          },
          "awards": {
            "$round": {
              ".validate": "newData.hasChildren(['at', 'items'])",
              "at": {
                ".validate": "newData.isNumber()"
              }
            }
          },
          "adjust": {
            "$key": {
              ".validate": "newData.hasChildren(['team', 'delta', 'at'])",
              "team": {
                ".validate": "newData.isString() && newData.val().matches(/^t[1-6]$/)"
              },
              "delta": {
                ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true || ($uid === auth.uid && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && !data.exists() && root.child('rooms/'+$code+'/public/phase').exists() && root.child('rooms/'+$code+'/public/settings/lockJoin').val() !== true))",
            ".validate": "newData.hasChildren(['name', 'team', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "team": {
              ".validate": "newData.isString() && root.child('rooms/'+$code+'/public/settings/teams').child(newData.val()).exists()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && (root.child('rooms/'+$code+'/players/'+auth.uid).exists() || root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true)) || (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true && !newData.exists()))",
            ".validate": "newData.isNumber() || newData.isBoolean()"
          }
        },
        "reps": {
          ".read": "auth != null",
          "$team": {
            ".write": "auth != null && (root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true || (!root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && root.child('rooms/'+$code+'/players/'+auth.uid).exists() && !data.exists() && newData.val() === auth.uid && root.child('rooms/'+$code+'/players/'+auth.uid+'/team').val() === $team))",
            ".validate": "newData.isString()"
          }
        },
        "answers": {
          "$roundId": {
            ".read": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            "$uid": {
              ".read": "auth != null && $uid === auth.uid",
              ".write": "auth != null && $uid === auth.uid && newData.exists() && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && root.child('rooms/'+$code+'/players/'+auth.uid).exists() && $roundId === root.child('rooms/'+$code+'/public/roundId').val() && root.child('rooms/'+$code+'/public/phase').val() === 'answering' && ((root.child('rooms/'+$code+'/public/timer/state').val() === 'running' && now <= root.child('rooms/'+$code+'/public/timer/endsAt').val() + root.child('rooms/'+$code+'/public/settings/graceMs').val()) || root.child('rooms/'+$code+'/public/timer/state').val() === 'paused') && (data.exists() ? root.child('rooms/'+$code+'/public/settings/allowEdit').val() === true : true) && (root.child('rooms/'+$code+'/public/settings/mode').val() !== 'team' || root.child('rooms/'+$code+'/reps/'+root.child('rooms/'+$code+'/players/'+auth.uid+'/team').val()).val() === auth.uid)",
              ".validate": "newData.hasChildren(['text', 'ts', 't0'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= root.child('rooms/'+$code+'/public/settings/minChars').val() && newData.val().length <= root.child('rooms/'+$code+'/public/settings/maxChars').val() && newData.val().matches(/[^ \\n\\t\\r]/)"
              },
              "ts": {
                ".validate": "newData.val() === now"
              },
              "t0": {
                ".validate": "newData.val() === (data.exists() ? data.val() : now)"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "submitted": {
          ".read": "auth != null",
          "$roundId": {
            ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && newData.val() === true && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && newData.parent().parent().parent().child('answers').child($roundId).child($uid).exists()",
              ".validate": "newData.val() === true"
            }
          }
        },
        "votes": {
          "$roundId": {
            ".read": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            "$uid": {
              ".read": "auth != null && $uid === auth.uid",
              ".write": "auth != null && $uid === auth.uid && newData.exists() && !root.child('rooms/'+$code+'/banned/'+auth.uid).exists() && root.child('rooms/'+$code+'/players/'+auth.uid).exists() && $roundId === root.child('rooms/'+$code+'/public/roundId').val() && root.child('rooms/'+$code+'/public/phase').val() === 'voting' && root.child('rooms/'+$code+'/public/vote/open').val() === true && newData.val() >= 0 && newData.val() < root.child('rooms/'+$code+'/public/vote/count').val() && newData.val() !== root.child('rooms/'+$code+'/private/optionOf/'+$roundId+'/'+auth.uid).val()",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "banned": {
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true)",
            ".write": "auth != null && root.child('rooms/'+$code+'/hostUids/'+auth.uid).val() === true",
            ".validate": "newData.val() === true"
          }
        }
      }
    }
  }
}
